# 复制本文件为 .env 并按需填写；也可直接在托管平台的环境变量里配置。
# 注意：.env 含密码，不要提交到公开仓库（.gitignore 已忽略）。

# 服务端口（托管平台一般会自动注入，本地默认 3000）
PORT=3000

# ===== 存储后端 =====
# 填了就写 MongoDB，留空就写本地 data/db.json
MONGODB_URI=
MONGODB_DB=zuofanba
MONGODB_COLLECTION=appstate
MONGODB_TIMEOUT=8000

# ===== 持久化目录（可选）=====
# 挂载持久卷时把数据与图片指过去，避免重启丢数据
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads

NODE_ENV=production
